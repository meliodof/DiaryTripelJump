<?xml version="1.0" encoding="utf-8"?>
<!-- Облачный бэкап и перенос между устройствами (Android 12+): дневник, настройки и аватар. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="triple_jump_database" />
        <include domain="sharedpref" path="diary_prefs.xml" />
        <include domain="file" path="avatars/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="triple_jump_database" />
        <include domain="sharedpref" path="diary_prefs.xml" />
        <include domain="file" path="avatars/" />
    </device-transfer>
</data-extraction-rules>
